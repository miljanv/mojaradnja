generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  clerkId            String             @unique
  email              String             @unique
  name               String?
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  shops              Shop[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Shop {
  id                String            @id @default(cuid())
  ownerId           String
  name              String
  slug              String            @unique
  description       String?
  instagramUsername String?
  phone             String?
  email             String?
  logoUrl           String?
  coverImageUrl     String?
  primaryColor      String            @default("#E85A6B")
  backgroundColor   String            @default("#FAFAFA")
  cardColor         String            @default("#F5F0EB")
  fontFamily        String            @default("roboto")
  heroTitle         String?
  heroSubtitle      String?
  returnPolicy      String?
  exchangePolicy    String?
  returnAddress     String?
  isPublished         Boolean           @default(false)
  orderCounter        Int               @default(1000)
  virtualTryOnEnabled Boolean           @default(false)
  aiCredits           Int               @default(0)
  /// KakoMiStoji: external buy/contact link used on the public result page.
  purchaseUrl         String?
  /// KakoMiStoji: owner-side switch. The public page needs this AND the
  /// admin-granted `virtualTryOnEnabled`.
  kmsPublicEnabled    Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  owner               User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products            Product[]
  customers           Customer[]
  orders              Order[]
  exchangeRequests    ExchangeRequest[]
  complaintRequests   ComplaintRequest[]
  messageTemplates    MessageTemplate[]
  categories          ShopCategory[]
  tryOnJobs           TryOnJob[]
  aiCreditTransactions AiCreditTransaction[]
  tryOnAnalyticsEvents TryOnAnalyticsEvent[]

  @@index([ownerId])
}

model ShopCategory {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id                   String           @id @default(cuid())
  shopId               String
  name                 String
  slug                 String
  description          String?
  price                Decimal          @db.Decimal(10, 2)
  compareAtPrice       Decimal?         @db.Decimal(10, 2)
  category             String?
  status               ProductStatus    @default(DRAFT)
  isFeatured           Boolean          @default(false)
  tryOnEnabled         Boolean          @default(false)
  tryOnCategory        String?
  tryOnPhotoType       String?
  tryOnGarmentImageKey String?
  /// KakoMiStoji: per-product buy link, overrides the shop-level one.
  purchaseUrl          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  shop                 Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  variants             ProductVariant[]
  orderItems           OrderItem[]
  tryOnJobs            TryOnJob[]

  @@unique([shopId, slug])
  @@index([shopId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  size        String?
  color       String?
  optionLabel String?
  optionValue String?
  attributes  Json?
  sku         String?
  stock       Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([productId])
}

model Customer {
  id                String            @id @default(cuid())
  shopId            String
  fullName          String
  phone             String
  email             String?
  instagramUsername String?
  address           String?
  city              String?
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders            Order[]
  exchangeRequests  ExchangeRequest[]
  complaintRequests ComplaintRequest[]

  @@unique([shopId, phone])
  @@index([shopId])
}

model Order {
  id              String            @id @default(cuid())
  shopId          String
  customerId      String
  orderNumber     String
  status          OrderStatus       @default(NEW)
  source          OrderSource       @default(MANUAL)
  totalAmount     Decimal           @db.Decimal(10, 2)
  deliveryAddress String?
  deliveryCity    String?
  customerPhone   String
  customerName    String
  note            String?
  internalNote    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  exchangeRequests ExchangeRequest[]
  complaintRequests ComplaintRequest[]
  tryOnJobs       TryOnJob[]

  @@unique([shopId, orderNumber])
  @@index([shopId, status])
  @@index([shopId, createdAt])
}

model OrderItem {
  id          String          @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  variantId   String?
  size        String?
  color       String?
  variantInfo String?
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  totalPrice  Decimal         @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model ExchangeRequest {
  id                   String         @id @default(cuid())
  shopId               String
  orderId              String
  customerId           String
  status               ExchangeStatus @default(NEW)
  reason               String?
  originalProductName  String
  originalSize         String?
  originalColor        String?
  requestedProductName String?
  requestedSize        String?
  requestedColor       String?
  shippingPaidBy       ShippingPaidBy @default(UNKNOWN)
  note                 String?
  internalNote         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  shop                 Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
}

model ComplaintRequest {
  id           String          @id @default(cuid())
  shopId       String
  orderId      String?
  customerId   String
  status       ComplaintStatus @default(NEW)
  reason       String
  description  String?
  resolution   String?
  note         String?
  internalNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
}

model MessageTemplate {
  id        String              @id @default(cuid())
  shopId    String
  type      MessageTemplateType
  title     String
  content   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, type])
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  SOLD_OUT
}

enum OrderStatus {
  NEW
  CONFIRMED
  WAITING_PAYMENT
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  EXCHANGE_IN_PROGRESS
}

enum OrderSource {
  MANUAL
  MINI_SHOP
  INSTAGRAM_DM
  VIBER
  WHATSAPP
  PHONE
}

enum ExchangeStatus {
  NEW
  WAITING_CUSTOMER_RETURN
  RECEIVED_RETURN
  NEW_ITEM_SENT
  COMPLETED
  REJECTED
  CANCELLED
}

enum ComplaintStatus {
  NEW
  REVIEWING
  APPROVED
  REJECTED
  REFUNDED
  REPLACED
  CLOSED
}

enum ShippingPaidBy {
  CUSTOMER
  SELLER
  SPLIT
  UNKNOWN
}

enum MessageTemplateType {
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  EXCHANGE_INSTRUCTIONS
  COMPLAINT_RECEIVED
  CUSTOM
}

enum TryOnJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AiCreditTransactionType {
  ADMIN_ADD
  ADMIN_REMOVE
  TRY_ON_USE
  TRY_ON_REFUND
}

enum TryOnAnalyticsEventType {
  TRY_ON_OPENED
  TRY_ON_STARTED
  TRY_ON_COMPLETED
  TRY_ON_FAILED
  ORDER_STARTED_AFTER_TRY_ON
  ORDER_CREATED_AFTER_TRY_ON
  KMS_LANDING_VIEW
  KMS_SHOP_VIEW
  KMS_PRODUCT_VIEW
  KMS_PHOTO_UPLOADED
  KMS_CONSENT_GIVEN
  KMS_SHARE_CLICKED
  KMS_BUY_CLICKED
  KMS_TRY_ANOTHER_CLICKED
}

model TryOnJob {
  id                  String         @id @default(cuid())
  shopId              String
  productId           String
  visitorSessionId    String?
  orderId             String?
  provider            String         @default("fal-fashn-v1.6")
  providerRequestId   String?
  personImageKey      String
  resultImageKey      String?
  status              TryOnJobStatus @default(PENDING)
  creditConsumed      Boolean        @default(false)
  creditRefunded      Boolean        @default(false)
  errorCode           String?
  errorMessage        String?
  idempotencyKey      String?        @unique
  /// KakoMiStoji: opaque token for the public shareable result page.
  shareToken          String?        @unique
  retryCount          Int            @default(0)
  createdAt           DateTime       @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  personImageDeletedAt DateTime?
  resultImageDeletedAt DateTime?
  shop                Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  order               Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  creditTransactions  AiCreditTransaction[]
  analyticsEvents     TryOnAnalyticsEvent[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([productId])
  @@index([visitorSessionId, productId, status])
  @@index([providerRequestId])
  @@index([status, createdAt])
}

model AiCreditTransaction {
  id              String                   @id @default(cuid())
  shopId          String
  tryOnJobId      String?
  amount          Int
  type            AiCreditTransactionType
  note            String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  shop            Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tryOnJob        TryOnJob?                @relation(fields: [tryOnJobId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([tryOnJobId])
}

model TryOnAnalyticsEvent {
  id               String                   @id @default(cuid())
  shopId           String
  productId        String?
  tryOnJobId       String?
  visitorSessionId String?
  orderId          String?
  type             TryOnAnalyticsEventType
  metadata         Json?
  createdAt        DateTime                 @default(now())
  shop             Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tryOnJob         TryOnJob?                @relation(fields: [tryOnJobId], references: [id], onDelete: SetNull)

  @@index([shopId, type, createdAt])
  @@index([tryOnJobId])
  @@index([visitorSessionId])
}
