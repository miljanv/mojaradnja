# Base URL of the "Probaj" backend (the MojShop Next.js API).
# Web / iOS simulator can use localhost. On a physical device use your LAN IP,
# e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat public SDK keys (leave empty to use the demo purchase flow).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
