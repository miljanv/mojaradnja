# ------------------------------------------------------------------
# web/.env  — kopiraj u web/.env i popuni vrednosti
# ------------------------------------------------------------------

# Baza (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Clerk (autentifikacija web dashboarda)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard/onboarding

# UploadThing (skladištenje slika — potrebno za pravi AI try-on)
UPLOADTHING_TOKEN=
NEXT_PUBLIC_UPLOADTHING_APP_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PANEL_PASSWORD=promeni-me

# fal.ai — virtual try-on (ostavi prazno za demo rezultat)
FAL_KEY=
TRY_ON_PROVIDER=fal-fashn-v1.6
TRY_ON_INPUT_RETENTION_HOURS=24
TRY_ON_RESULT_RETENTION_HOURS=24
CRON_SECRET=promeni-me

# Resend (opciono — email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="MojShop <onboarding@resend.dev>"

# ---- Mobilna aplikacija (backend) ----
# RevenueCat webhook secret (Authorization: Bearer <secret>) za dodelu kredita
REVENUECAT_WEBHOOK_SECRET=
# Twilio (opciono — pravi SMS OTP). Bez ovoga radi demo režim (kod se auto-popuni).
TWILIO_AUTH_TOKEN=
